{
  "name": "mansiondeseo-escorts-directory",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/write-assets-ignore.mjs",
    "preview": "astro preview",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute escorts-directory-db --local --file=db/schema.sql",
    "db:migrate:remote": "wrangler d1 execute escorts-directory-db --remote --file=db/schema.sql",
    "db:migrate:email": "wrangler d1 execute escorts-directory-db --remote --file=db/migrations/0005_email_verification.sql",
    "db:migrate:dummy": "wrangler d1 execute escorts-directory-db --remote --file=db/migrations/0002_dummy_profiles.sql",
    "db:migrate:source-details": "wrangler d1 execute escorts-directory-db --remote --file=db/migrations/0006_source_profile_details.sql",
    "seed:dummy": "node scripts/seed-dummy-profiles.mjs",
    "import:argxp": "node scripts/import-argxp-profiles.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.0",
    "astro": "^5.16.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "wrangler": "^4.46.0"
  }
}
