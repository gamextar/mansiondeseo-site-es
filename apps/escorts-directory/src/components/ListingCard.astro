---
import { ESCORT_TIERS, type EscortTier } from '../lib/tiers';

interface Props {
  slug: string;
  displayName: string;
  cityName: string;
  priceAmount: number;
  currency: string;
  tier: EscortTier;
  shortBio: string;
  photo: string;
  eager?: boolean;
}

const { slug, displayName, cityName, priceAmount, currency, tier, shortBio, photo, eager = false } = Astro.props;
const tierMeta = ESCORT_TIERS[tier];
---

<article class="listing-card">
  <a href={`/escort/${slug}/`} class="listing-image-link" aria-label={`Ver perfil de ${displayName}`}>
    <img
      src={photo}
      alt={`Foto principal de ${displayName}`}
      width="640"
      height="853"
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      fetchpriority={eager ? 'high' : 'auto'}
    />
    <div class="listing-overlay">
      <div class="listing-topline">
        <span class="tier-badge" style={`--tier-color:${tierMeta.accent}`}>{tierMeta.label}</span>
        <span class="price">Desde {new Intl.NumberFormat('es-AR', { style: 'currency', currency, maximumFractionDigits: 0 }).format(priceAmount)} / hora</span>
      </div>
      <div class="listing-copy">
        <h2>{displayName}</h2>
        <p class="city"><span aria-hidden="true">●</span> {cityName}</p>
        <p class="summary">{shortBio}</p>
      </div>
    </div>
  </a>
</article>
