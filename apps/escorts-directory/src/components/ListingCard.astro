---
import type { EscortTier } from '../lib/tiers';

interface Props {
  slug: string;
  displayName: string;
  cityName: string;
  priceAmount: number;
  currency: string;
  tier: EscortTier;
  shortBio: string;
  photo: string;
  photoSmall?: string;
  eager?: boolean;
}

const { slug, displayName, cityName, priceAmount, currency, photo, photoSmall = '', eager = false } = Astro.props;
const priceLabel = `${new Intl.NumberFormat('en-US', { maximumFractionDigits: 0 }).format(priceAmount)} ${currency || 'USD'}`;
const srcset = photoSmall ? `${photoSmall} 320w, ${photo} 640w` : undefined;
---

<article class="listing-card">
  <a href={`/escort/${slug}/`} class="listing-image-link" aria-label={`Ver perfil de ${displayName}`}>
    <img
      src={photo}
      alt={`Foto principal de ${displayName}`}
      width="640"
      height="853"
      srcset={srcset}
      sizes="(max-width: 800px) 50vw, 25vw"
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      fetchpriority={eager ? 'high' : 'auto'}
    />
    <div class="listing-overlay">
      <div class="listing-topline">
        <span class="price">{priceLabel}</span>
      </div>
      <div class="listing-copy">
        <h2>{displayName}</h2>
        <p class="city"><span aria-hidden="true">●</span> {cityName}</p>
      </div>
    </div>
  </a>
</article>
