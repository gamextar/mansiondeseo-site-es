---
import PublicLayout from '../../layouts/PublicLayout.astro';
import { isAdminRequest } from '../../lib/auth';
import { ESCORT_TIERS } from '../../lib/tiers';
import { runtimeEnv } from '../../lib/runtime';
export const prerender = false;

const env = runtimeEnv(Astro.locals);
const isAdmin = await isAdminRequest(Astro.request, env);
const requestUrl = new URL(Astro.request.url);
const query = (requestUrl.searchParams.get('q') || '').trim().slice(0, 100);
const statusParam = (requestUrl.searchParams.get('status') || 'all').trim();
const allowedStatuses = ['all', 'draft', 'pending_review', 'published', 'paused', 'rejected', 'expired'];
const statusFilter = allowedStatuses.includes(statusParam) ? statusParam : 'all';
const pageSize = 50;
const pageNumber = Math.max(1, Number.parseInt(requestUrl.searchParams.get('page') || '1', 10) || 1);
const searchPattern = `%${query}%`;
const filterSql = [
  ...(query ? ['(p.display_name LIKE ? OR p.slug LIKE ? OR p.city_name LIKE ? OR a.email LIKE ?)'] : []),
  ...(statusFilter !== 'all' ? ['p.status = ?'] : []),
].join(' AND ') || '1 = 1';
const filterBinds = [
  ...(query ? [searchPattern, searchPattern, searchPattern, searchPattern] : []),
  ...(statusFilter !== 'all' ? [statusFilter] : []),
];
const pendingRows = isAdmin ? await env.DB?.prepare("SELECT p.*, a.email FROM escort_profiles p JOIN escort_accounts a ON a.id = p.account_id WHERE p.status = 'pending_review' ORDER BY p.updated_at ASC").all<any>() : { results: [] };
const pending = await Promise.all((pendingRows?.results || []).map(async (profile: any) => ({
  ...profile,
  photos: (await env.DB.prepare("SELECT id, status, sort_order FROM escort_photos WHERE profile_id = ? ORDER BY sort_order").bind(profile.id).all<any>()).results || [],
})));
let totalProfiles = 0;
let profiles: any[] = [];
if (isAdmin && env.DB) {
  const total = await env.DB.prepare(`SELECT COUNT(*) AS total FROM escort_profiles p JOIN escort_accounts a ON a.id = p.account_id WHERE ${filterSql}`).bind(...filterBinds).first<any>();
  totalProfiles = Number(total?.total || 0);
  const offset = (pageNumber - 1) * pageSize;
  const result = await env.DB.prepare(`SELECT p.id, p.slug, p.display_name, p.city_name, p.price_amount, p.currency, p.status, p.created_at, p.updated_at, p.published_at, a.email,
      COALESCE((SELECT ep.tier FROM escort_promotions ep WHERE ep.profile_id = p.id AND ep.status = 'active' ORDER BY ep.created_at DESC LIMIT 1), 'basic') AS tier,
      (SELECT COUNT(*) FROM escort_photos photo WHERE photo.profile_id = p.id) AS photo_count,
      (SELECT COUNT(*) FROM escort_reports report WHERE report.profile_id = p.id AND report.status = 'open') AS open_reports
    FROM escort_profiles p JOIN escort_accounts a ON a.id = p.account_id
    WHERE ${filterSql} ORDER BY CASE p.status WHEN 'pending_review' THEN 0 WHEN 'published' THEN 1 ELSE 2 END, p.updated_at DESC LIMIT ? OFFSET ?`).bind(...filterBinds, pageSize, offset).all<any>();
  profiles = result.results || [];
}
const totalPages = Math.max(1, Math.ceil(totalProfiles / pageSize));
const pageUrl = (nextPage: number) => {
  const url = new URL(requestUrl);
  url.searchParams.set('page', String(nextPage));
  return `${url.pathname}?${url.searchParams.toString()}`;
};
const statusLabels: Record<string, string> = { draft: 'Borrador', pending_review: 'Pendiente', published: 'Publicado', paused: 'Pausado', rejected: 'Rechazado', expired: 'Vencido' };
const bulkNotice = requestUrl.searchParams.get('bulk') || '';
Astro.response.headers.set('Cache-Control', 'private, no-store');
---

<PublicLayout title="Administración | Mansión Deseo Escorts" description="Panel privado de administración." canonicalPath="/admin/" noindex={true}>
  <section class="content-page admin-page">
    {!isAdmin ? <form class="form-card" method="post" action="/api/admin/login"><h1>Administración</h1><p>Panel privado de Mansión Deseo Escorts.</p><label>Clave de administración <input name="token" type="password" autocomplete="current-password" required /></label><button>Ingresar</button></form> : <>
      <div class="admin-header"><div><p class="eyebrow">Gestión privada</p><h1>Perfiles y usuarios</h1><p class="admin-muted">{totalProfiles} perfiles encontrados · máximo 50 por página</p></div><a class="button-secondary admin-site-link" href="/">Ver sitio público</a></div>
      {bulkNotice && <p class="form-notice success">Acción masiva completada: {bulkNotice.replaceAll('-', ' ')}.</p>}
      <section class="admin-panel"><div class="admin-panel-heading"><div><h2>Buscar y filtrar</h2><p class="admin-muted">Nombre, slug, ciudad o correo de la cuenta.</p></div><span class="admin-count">{totalProfiles} resultados</span></div><form class="admin-toolbar" method="get" action="/admin/"><input name="q" value={query} placeholder="Buscar perfil, ciudad o email" aria-label="Buscar perfiles" /><select name="status" aria-label="Filtrar por estado">{allowedStatuses.map((status) => <option value={status} selected={status === statusFilter}>{status === 'all' ? 'Todos los estados' : statusLabels[status]}</option>)}</select><button>Buscar</button>{(query || statusFilter !== 'all') && <a class="button-secondary" href="/admin/">Limpiar</a>}</form></section>
      <section class="admin-panel"><div class="admin-panel-heading"><div><h2>Acciones masivas</h2><p class="admin-muted">Selecciona perfiles en la tabla. Las eliminaciones borran fotos, reseñas, reportes y la cuenta.</p></div></div><form id="bulk-form" method="post" action="/api/admin/profiles/bulk" class="bulk-toolbar"><select name="action" aria-label="Acción masiva"><option value="publish">Publicar seleccionados</option><option value="pause">Pausar seleccionados</option><option value="reject">Rechazar seleccionados</option><option value="delete">Eliminar seleccionados</option></select><input name="note" maxlength="600" placeholder="Nota opcional para rechazar" aria-label="Nota de moderación" /><button type="submit" class="button-danger">Aplicar a seleccionados</button></form></section>
      <section class="admin-panel admin-table-wrap"><div class="admin-panel-heading"><h2>Listado de perfiles</h2><span class="admin-muted">Página {Math.min(pageNumber, totalPages)} de {totalPages}</span></div>{profiles.length === 0 ? <p class="admin-muted">No hay perfiles que coincidan con la búsqueda.</p> : <table class="admin-table"><thead><tr><th><input type="checkbox" data-select-all aria-label="Seleccionar todos los perfiles visibles" /></th><th>Perfil</th><th>Estado</th><th>Fotos</th><th>Reportes</th><th>Nivel</th><th>Acción</th></tr></thead><tbody>{profiles.map((profile: any) => <tr><td><input form="bulk-form" type="checkbox" name="profile_id" value={profile.id} data-profile-checkbox aria-label={`Seleccionar ${profile.display_name}`} /></td><td><strong>{profile.display_name}</strong><span class="admin-subline">{profile.city_name} · {profile.email}</span><span class="admin-subline">Actualizado {String(profile.updated_at || '').replace('T', ' ')}</span></td><td><span class={`status-pill status-${profile.status}`}>{statusLabels[profile.status] || profile.status}</span></td><td>{profile.photo_count}</td><td>{profile.open_reports > 0 ? <span class="report-count">{profile.open_reports}</span> : '—'}</td><td><span class="tier-label">{ESCORT_TIERS[profile.tier as keyof typeof ESCORT_TIERS]?.label || profile.tier}</span></td><td><div class="admin-row-actions"><a href={`/escort/${profile.slug}/`} target="_blank" rel="noopener">Ver</a>{profile.status === 'published' && <form method="post" action={`/api/admin/profiles/${profile.id}/promotion`}><select name="tier" aria-label={`Nivel de ${profile.display_name}`}>{Object.entries(ESCORT_TIERS).map(([value, tier]) => <option value={value} selected={value === profile.tier}>{tier.label}</option>)}</select><input name="ends_at" type="datetime-local" aria-label="Fin de promoción" /><button>Guardar nivel</button></form>}</div></td></tr>)}</tbody></table>}{totalPages > 1 && <nav class="admin-pagination" aria-label="Paginación de perfiles">{pageNumber > 1 && <a class="button-secondary" href={pageUrl(pageNumber - 1)}>Anterior</a>}<span>Página {pageNumber} / {totalPages}</span>{pageNumber < totalPages && <a class="button-secondary" href={pageUrl(pageNumber + 1)}>Siguiente</a>}</nav>}</section>
      <section class="admin-panel"><div class="admin-panel-heading"><div><h2>Moderación pendiente</h2><p class="admin-muted">Revisión individual de perfiles y fotos nuevas.</p></div><span class="admin-count">{pending.length}</span></div>{pending.length === 0 && <p class="admin-muted">No hay perfiles pendientes.</p>}{pending.map((profile: any) => <article class="moderation-card"><h3>{profile.display_name} · {profile.city_name}</h3><p class="admin-subline">{profile.email}</p><p>{profile.short_bio}</p><div class="moderation-photos">{profile.photos.map((photo: any) => <div><a href={`/api/admin/photos/${photo.id}/source`} target="_blank">Ver foto {photo.sort_order + 1}</a> · {photo.status}{photo.status === 'pending_review' && <><form method="post" action={`/api/admin/photos/${photo.id}/approve`}><button>Aprobar foto</button></form><form method="post" action={`/api/admin/photos/${photo.id}/reject`}><button class="button-danger">Rechazar foto</button></form></>}</div>)}</div><div class="action-row"><form method="post" action={`/api/admin/profiles/${profile.id}/approve`}><button>Aprobar perfil</button></form><form method="post" action={`/api/admin/profiles/${profile.id}/reject`}><input name="note" placeholder="Motivo si se rechaza" /><button class="button-danger">Rechazar perfil</button></form></div></article>)}</section>
    </>}
  </section>
</PublicLayout>

{isAdmin && <script>
  const all = document.querySelector('[data-select-all]');
  const boxes = () => [...document.querySelectorAll('[data-profile-checkbox]')];
  all?.addEventListener('change', () => boxes().forEach((box) => { box.checked = all.checked; }));
  document.querySelector('#bulk-form')?.addEventListener('submit', (event) => {
    const selected = boxes().filter((box) => box.checked).length;
    if (!selected) { event.preventDefault(); alert('Selecciona al menos un perfil.'); return; }
    const action = document.querySelector('#bulk-form select[name="action"]')?.value;
    if (action === 'delete' && !confirm(`¿Eliminar ${selected} perfil(es) permanentemente? Esta acción borra también sus fotos, reseñas, reportes y cuentas.`)) event.preventDefault();
  });
</script>}
