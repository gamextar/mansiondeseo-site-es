---
import PublicLayout from '../../../layouts/PublicLayout.astro';
import ListingCard from '../../../components/ListingCard.astro';
import { getPublicCities, getPublicListings } from '../../../lib/public-catalogue';
export const prerender = false;
const env = (Astro.locals as any)?.runtime?.env || {};
const slug = Astro.params.city || '';
const [cities, listings] = await Promise.all([getPublicCities(env), getPublicListings(env, slug)]);
const city = cities.find((item) => item.slug === slug);
if (!city) return new Response('No encontrado', { status: 404 });
const intro = slug === 'buenos-aires'
  ? 'Encontrá perfiles de escorts en Buenos Aires y sus principales zonas: Palermo, Recoleta, Puerto Madero, Belgrano, Núñez y otros barrios del área metropolitana.'
  : `Explorá perfiles públicos de escorts en ${city.name}, con fotografías, ubicación y contacto directo.`;
const metaDescription = slug === 'buenos-aires'
  ? 'Escorts en Buenos Aires: perfiles públicos de Palermo, Recoleta, Puerto Madero, Belgrano y otras zonas, con fotografías y contacto directo.'
  : `Perfiles de escorts en ${city.name}, publicados después de revisión manual.`;
Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=300, stale-while-revalidate=300');
Astro.response.headers.set('Cache-Tag', `escort-city-${slug}`);
---

<PublicLayout
  title={`Escorts en ${city.name} | Mansión Deseo`}
  description={metaDescription}
  canonicalPath={`/escorts/${city.slug}/`}
  preloadImage={listings[0]?.photo}
>
  <section class="hero hero-compact">
    <p class="eyebrow">Explorar por ciudad</p>
    <h1>Escorts en {city.name}</h1>
    <p>{intro}</p>
  </section>
  <section class="gallery-section" aria-label={`Perfiles en ${city.name}`}>
    <div class="listing-grid">
    {listings.map((listing, index) => <ListingCard {...listing} eager={index === 0} />)}
    </div>
    {listings.length === 0 && <p class="empty-state">No hay perfiles publicados actualmente.</p>}
  </section>
</PublicLayout>
