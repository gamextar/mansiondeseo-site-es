---
import PublicLayout from '../layouts/PublicLayout.astro';
import ListingCard from '../components/ListingCard.astro';
import { ESCORT_TIERS } from '../lib/tiers';
import { getPublicCities, getPublicListings } from '../lib/public-catalogue';
export const prerender = false;
const env = (Astro.locals as any)?.runtime?.env || {};
const [cities, listings] = await Promise.all([getPublicCities(env), getPublicListings(env)]);
const sections = Object.entries(ESCORT_TIERS).reverse().map(([key, meta]) => ({ key, ...meta, listings: listings.filter((listing) => listing.tier === key) }));
Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=300, stale-while-revalidate=300');
Astro.response.headers.set('Cache-Tag', 'escort-home');
---

<PublicLayout
  title="Escorts en Argentina | Mansión Deseo"
  description="Directorio de escorts con perfiles públicos y revisión manual. Explorá anuncios por ciudad."
>
  <section class="hero">
    <p class="eyebrow">Directorio independiente</p>
    <h1>Escorts en Argentina</h1>
    <p>Perfiles públicos, fotografías revisadas y búsqueda por ciudad.</p>
  </section>

  <section class="city-links" aria-label="Explorar por ciudad">
    {cities.map((city) => <a href={`/escorts/${city.slug}/`}>{city.name} <small>({city.count})</small></a>)}
  </section>

  {sections.map((section) => <section class={`gallery-section tier-section tier-${section.key}`} aria-labelledby={`tier-${section.key}-title`}>
    <div class="section-heading"><div><p class="eyebrow" style={`--tier-color:${section.accent}`}>{section.label}</p><h2 id={`tier-${section.key}-title`}>{section.label}</h2></div><span>{section.listings.length} perfiles</span></div>
    {section.listings.length > 0 ? <div class="listing-grid">
      {section.listings.map((listing, index) => <ListingCard {...listing} eager={index < 4} />)}
    </div> : <p class="empty-state">Todavía no hay perfiles publicados en este nivel.</p>}
  </section>)}
</PublicLayout>
