{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mansiondeseo-escorts",
  "workers_dev": true,
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "cache": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "escorts.mansiondeseo.com",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "escorts-directory-db",
      "database_id": "d8644fde-e9b4-413d-aeb0-0f9fac7359ee"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ESCORT_MEDIA_PRIVATE",
      "bucket_name": "mansiondeseo-escorts-private"
    },
    {
      "binding": "ESCORT_MEDIA_PUBLIC",
      "bucket_name": "mansiondeseo-escorts-public"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "vars": {
    "PUBLIC_SITE_ORIGIN": "https://escorts.mansiondeseo.com",
    "PUBLIC_MEDIA_ORIGIN": "https://media-escorts.mansiondeseo.com",
    "STAGING_NO_INDEX": "0",
    "MAIL_FROM": "noreply@mansiondeseo.com",
    "REGISTRATION_EMAIL_BCC": "registro@gamextar.com"
  }
}
